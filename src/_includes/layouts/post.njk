---
layout: layouts/base.njk
---
{% set cats = normalizeCategories({ category: category, categories: categories }) %}
{% set primary = cats[0] %}
{% set authorInfo = authors[author] %}
{% set isRoundtable = primary and primary.key == 'roundtable' %}

<article class="post{% if primary %} cat-{{ primary.key }}{% endif %}" itemscope itemtype="https://schema.org/NewsArticle">
  <header class="post-head">
    {% if primary %}
      <a class="kicker cat-{{ primary.key }}" href="/category/{{ primary.key }}/">{{ primary.name }}</a>
    {% endif %}
    <h1 class="post-hed" itemprop="headline">{{ title }}</h1>
    {% if excerpt or description %}
      <p class="post-dek">{{ excerpt or description }}</p>
    {% endif %}
    <div class="byline-row">
      {% if authorInfo %}
        <img class="avatar" src="{{ authorInfo.avatar }}" alt="" width="28" height="28">
      {% elif isRoundtable %}
        <img class="avatar" src="/assets/images/seal.png" alt="" width="28" height="28">
      {% endif %}
      {% if author %}<span class="name sc" itemprop="author">{{ author }}</span><span class="dot">·</span>{% endif %}
      {% if date %}<time datetime="{{ date | isoDate }}" itemprop="datePublished">{{ date | displayDate('en-US') }}</time><span class="dot">·</span>{% endif %}
      <span>{{ content | readingTime }}</span>
    </div>
  </header>

  {% if image %}
    <figure class="post-hero" itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
      <img src="{{ image }}" alt="{{ title | safe }}" loading="eager" decoding="async" width="1200" height="675">
      <meta itemprop="url" content="{{ image }}">
      {% if image_credit %}
        <figcaption>Photograph: {{ image_credit }}</figcaption>
      {% elif imageCaption %}
        <figcaption>{{ imageCaption | safe }}</figcaption>
      {% endif %}
    </figure>
  {% endif %}

  <section class="post-body{% if isRoundtable %} is-chat{% endif %}" itemprop="articleBody">
    {% if isRoundtable %}{{ content | chatify | safe }}{% else %}{{ content | safe }}{% endif %}
  </section>

  <footer class="post-end">
    {% if primary %}
      <span>Filed under <a class="kicker cat-{{ primary.key }}" href="/category/{{ primary.key }}/">{{ primary.name }}</a></span>
    {% endif %}
    {% if author %}<span class="sc">{{ author }}{% if authorInfo and authorInfo.role %} · {{ authorInfo.role }}{% endif %}</span>{% endif %}
  </footer>

  {# Related: same primary category, newest first, excluding current #}
  {% if collections.posts and primary %}
    {% set related = [] %}
    {% for p in collections.posts %}
      {% if related.length < 3 and p.url != page.url and p.data._primaryCategoryKey == primary.key %}
        {% set related = related.concat([p]) %}
      {% endif %}
    {% endfor %}
    {% if related.length %}
    <section class="related" aria-labelledby="related-heading">
      <h2 class="related-title sc" id="related-heading">More in {{ primary.name }}</h2>
      <ul class="related-list">
        {% for p in related %}
          <li>
            <figure class="thumb">
              <a href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                <img src="{{ p.data.image or '/assets/fallback.svg' }}" alt="" loading="lazy" decoding="async" width="480" height="270">
              </a>
            </figure>
            <div class="hed"><a href="{{ p.url }}">{{ p.data.title }}</a></div>
            <div class="meta">
              {% if p.data.author %}{{ p.data.author }} · {% endif %}
              <time datetime="{{ p.date | isoDate }}">{{ p.date | displayDate('en-US') }}</time>
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  {% endif %}

  {# Previous / next by publication date #}
  {% set newer = null %}
  {% set older = null %}
  {% set found = false %}
  {% for p in collections.posts %}
    {% if found and not older %}{% set older = p %}{% endif %}
    {% if p.url == page.url %}{% set found = true %}{% endif %}
    {% if not found %}{% set newer = p %}{% endif %}
  {% endfor %}
  {% if newer or older %}
  <nav class="post-nav" aria-label="Adjacent articles">
    {% if older %}
      <a href="{{ older.url }}"><span class="dir sc">← Earlier</span>{{ older.data.title }}</a>
    {% endif %}
    {% if newer %}
      <a class="next" href="{{ newer.url }}"><span class="dir sc">Later →</span>{{ newer.data.title }}</a>
    {% endif %}
  </nav>
  {% endif %}
</article>
