<footer class="site-footer" role="contentinfo">
  <div class="wrap newsletter">
    <div>
      <h2 id="newsletter-title">The Argosy in your inbox</h2>
      <p>New columns, roundtables and NIE worksheets, sent now and then. No spam, and you can unsubscribe anytime.</p>
    </div>
    <form name="newsletter" method="POST" action="/newsletter/thanks/" data-netlify="true" netlify-honeypot="bot-field" aria-labelledby="newsletter-title">
      <p hidden><label>Don't fill this out: <input name="bot-field"></label></p>
      <label class="visually-hidden" for="newsletter-email">Email address</label>
      <input id="newsletter-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>
      <button type="submit" class="btn">Sign up</button>
    </form>
  </div>
  <div class="wrap">
    <div class="f-brand">
      <span class="wordmark">The Argosy</span>
      <p>An independent student newspaper. An argosy is a merchant ship — a vessel built by many hands, carrying ideas across distance.</p>
    </div>
    <nav class="f-sections" aria-label="Sections">
      <h2>Sections</h2>
      <ul>
        <li><a href="/category/politics/">Politics</a></li>
        <li><a href="/category/culture/">Culture</a></li>
        <li><a href="/category/economics-and-finance/">Economics</a></li>
        <li><a href="/category/sustainability/">Sustainability</a></li>
        <li><a href="/category/health-and-medicine/">Health</a></li>
        <li><a href="/category/psychology/">Psychology</a></li>
        <li><a href="/category/sports/">Sports</a></li>
        <li><a href="/category/education/">Education</a></li>
        <li><a href="/category/science-and-technology/">Science &amp; Technology</a></li>
        <li><a href="/category/roundtable/">The Roundtable</a></li>
        <li><a href="/categories/">All sections</a></li>
      </ul>
    </nav>
    <nav class="f-pages" aria-label="The paper">
      <h2>The Paper</h2>
      <ul>
        <li><a href="/about/">About us</a></li>
        <li><a href="/team/">Meet the team</a></li>
        {% if nie.live or eleventy.env.runMode == "serve" %}<li><a href="/about/nie/">Newspaper in Education</a></li>{% endif %}
        <li><a href="/join/">Join us</a></li>
        <li><a href="mailto:editors@theargosy.org">editors@theargosy.org</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap">
    <div class="colophon">
      <span>&copy; {{ now | date('yyyy') }} The Argosy. All rights reserved.</span>
      <span>Founded 2023 · Published from five time zones</span>
    </div>
  </div>
</footer>
