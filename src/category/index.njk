---
title: All Sections
permalink: /categories/index.html
layout: layouts/base.njk
---

<header class="cat-head">
  <h1>All Sections</h1>
  <p class="count sc">Every desk of The Argosy, by flag</p>
</header>

<ul class="cats-grid">
  {% for c in collections.categoryList %}
    <li>
      <a class="cat-{{ c.key }}" href="/category/{{ c.key }}/">
        <span>{{ c.name }}</span>
        <span class="n">{{ c.count }} {% if c.count == 1 %}story{% else %}stories{% endif %}</span>
      </a>
    </li>
  {% endfor %}
</ul>
