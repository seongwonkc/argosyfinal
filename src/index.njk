---
layout: layouts/base.njk
title: Home
---

{% set all = collections.posts %}
{% set hero = all[0] %}
{% set rest = all | exceptByUrl(hero.url if hero else null) %}
{% set catsAll = collections.categoryList %}

{% set topKeys = [
  'politics',
  'culture',
  'economics-and-finance',
  'sustainability',
  'health-and-medicine',
  'psychology',
  'sports',
  'roundtable'
] %}

{% set heroUrl = hero.url if hero else '' %}
{% set otherCats = [] %}
{% for c in catsAll %}
  {% if c.key not in topKeys %}
    {% set otherCats = otherCats.concat([c]) %}
  {% endif %}
{% endfor %}

{# Latest roundtable, for the band (skip it when it IS the lead story) #}
{% set rtBand = null %}
{% for c in catsAll %}
  {% if c.key == 'roundtable' %}
    {% if c.items[0] and c.items[0].url != heroUrl %}
      {% set rtBand = c.items[0] %}
    {% elif c.items[1] %}
      {% set rtBand = c.items[1] %}
    {% endif %}
  {% endif %}
{% endfor %}

{# ============ Lead package ============ #}
<section class="lead-package" aria-label="Lead story">
  {% if hero %}
    <figure class="lead-media">
      <a href="{{ hero.url }}">
        <img src="{{ hero.data.image or '/assets/fallback.svg' }}"
             alt="{{ hero.data.title | safe }}" loading="eager" decoding="async"
             width="1200" height="800">
      </a>
    </figure>
    <div class="lead-text">
      {% if hero.data._primaryCategoryKey %}
        <a class="kicker cat-{{ hero.data._primaryCategoryKey }}"
           href="/category/{{ hero.data._primaryCategoryKey }}/">{{ hero.data._primaryCategoryName }}</a>
      {% endif %}
      <h1 class="lead-hed"><a href="{{ hero.url }}">{{ hero.data.title }}</a></h1>
      <p class="dek">{{ hero.data.excerpt or hero.data.description or (hero.templateContent | striptags | truncate(200)) }}</p>
      <div class="byline-row">
        {% set heroAuthor = authors[hero.data.author] %}
        {% if heroAuthor %}<img class="avatar" src="{{ heroAuthor.avatar }}" alt="" width="36" height="36">{% endif %}
        {% if hero.data.author %}<span class="name sc">{{ hero.data.author }}</span><span class="dot">·</span>{% endif %}
        <time datetime="{{ hero.date | isoDate }}">{{ hero.date | displayDate('en-US') }}</time>
      </div>

      <div class="latest">
        <h2 class="latest-title sc">The Latest</h2>
        <ol>
          {% for post in rest | take(4) %}
            <li>
              <span class="hed"><a href="{{ post.url }}">{{ post.data.title }}</a></span>
              <div class="when">
                {% if post.data._primaryCategoryName %}{{ post.data._primaryCategoryName }} · {% endif %}
                <time datetime="{{ post.date | isoDate }}">{{ post.date | displayDate('en-US') }}</time>
              </div>
            </li>
          {% endfor %}
        </ol>
      </div>
    </div>
  {% endif %}
</section>

{# ============ Roundtable band ============ #}
{% if rtBand %}
<aside class="rt-band" aria-label="From the Roundtable">
  <div class="wrap">
    <img class="seal" src="/assets/images/seal.png" alt="" width="64" height="64">
    <div>
      <span class="kicker cat-roundtable">From the Roundtable</span>
      <p class="rt-quote"><a href="{{ rtBand.url }}">{{ rtBand.data.title }}</a></p>
      <div class="byline-row">
        <time datetime="{{ rtBand.date | isoDate }}">{{ rtBand.date | displayDate('en-US') }}</time>
      </div>
    </div>
  </div>
</aside>
{% endif %}

{# ============ Section blocks ============ #}
{% macro SectionBlock(c, heroUrl, rtUrl) %}
  {% set items = [] %}
  {% for p in c.items %}
    {% if p.url != heroUrl and p.url != rtUrl and items.length < 5 %}
      {% set items = items.concat([p]) %}
    {% endif %}
  {% endfor %}
  {% if items.length %}
  <section class="front-section cat-{{ c.key }}" aria-labelledby="sec-{{ c.key }}">
    <div class="section-head">
      <h2 class="section-name" id="sec-{{ c.key }}"><a href="/category/{{ c.key }}/">{{ c.name }}</a></h2>
      <a class="section-more sc" href="/category/{{ c.key }}/">All {{ c.count }} stories →</a>
    </div>
    <div class="section-grid">
      {% set lead = items[0] %}
      <article class="feature">
        <figure class="thumb">
          <a href="{{ lead.url }}" tabindex="-1" aria-hidden="true">
            <img src="{{ lead.data.image or '/assets/fallback.svg' }}" alt=""
                 loading="lazy" decoding="async" width="600" height="400">
          </a>
        </figure>
        <div>
          <h3 class="hed"><a href="{{ lead.url }}">{{ lead.data.title }}</a></h3>
          <p class="dek">{{ lead.data.excerpt or lead.data.description or '' | truncate(160) }}</p>
          <div class="byline-row">
            {% if lead.data.author %}<span class="name sc">{{ lead.data.author }}</span><span class="dot">·</span>{% endif %}
            <time datetime="{{ lead.date | isoDate }}">{{ lead.date | displayDate('en-US') }}</time>
          </div>
        </div>
      </article>
      <ul class="headline-list">
        {% for post in items | take(5) %}
          {% if not loop.first %}
          <li>
            <span class="hed"><a href="{{ post.url }}">{{ post.data.title }}</a></span>
            <div class="meta">
              {% if post.data.author %}{{ post.data.author }} · {% endif %}
              <time datetime="{{ post.date | isoDate }}">{{ post.date | displayDate('en-US') }}</time>
            </div>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}
{% endmacro %}

{% set rtUrl = rtBand.url if rtBand else '' %}

{% for k in topKeys %}
  {% for c in catsAll %}
    {% if c.key == k %}{{ SectionBlock(c, heroUrl, rtUrl) }}{% endif %}
  {% endfor %}
{% endfor %}

{% for c in otherCats %}
  {{ SectionBlock(c, heroUrl, rtUrl) }}
{% endfor %}
